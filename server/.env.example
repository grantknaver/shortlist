PORT=8787
# Comma-separated frontend origins allowed to call the API (your Cloudflare Pages URL in prod)
CORS_ORIGINS=http://localhost:5173
# Sent in the User-Agent to public weather APIs (NWS/IEM etiquette)
CONTACT_EMAIL=you@yourdomain.com
# Portland only (free server key: email maps@portlandoregon.gov, subject "PortlandMaps API Key Request")
PORTLANDMAPS_API_KEY=
HTTP_TIMEOUT_MS=20000

# Customer access keys. NEVER put keys in config/customers/*.json (git history keeps them forever).
# One per customer file: ACCESS_KEY_<ID in caps>. Use long random values in production, e.g.
#   python3 -c "import secrets;print(secrets.token_urlsafe(12))"
# These simple values are for local development only.
ACCESS_KEY_DEMO=demo
ACCESS_KEY_SAMPLE=sample
